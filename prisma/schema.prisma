// ═══════════════════════════════════════════════
// EduHire — Prisma Schema
// Database: PostgreSQL (Supabase)
// Auth: NextAuth.js
// ═══════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase connection pooling
}

// ─── Enums ───────────────────────────────────

enum UserRole {
  TEACHER
  SCHOOL_ADMIN
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING_FACULTY
}

enum ExperienceLevel {
  FRESHER
  ONE_TO_TWO_YEARS
  TWO_TO_FIVE_YEARS
  FIVE_TO_TEN_YEARS
  TEN_PLUS_YEARS
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
}

enum Board {
  CBSE
  ICSE
  STATE_BOARD
  IB
  CAMBRIDGE
  OTHER
}

enum AvailabilityStatus {
  ACTIVELY_LOOKING
  OPEN_TO_OFFERS
  NOT_LOOKING
  IMMEDIATE_JOINER
  PART_TIME_ONLY
  ONLINE_ONLY
  EXAM_SEASON
}

enum SchoolVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TeacherVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AlertFrequency {
  IMMEDIATE
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum RejectionReason {
  OVERQUALIFIED
  UNDERQUALIFIED
  POSITION_FILLED
  EXPERIENCE_MISMATCH
  LOCATION_MISMATCH
  SALARY_MISMATCH
  OTHER
}

enum InterviewType {
  VIDEO
  PHONE
  IN_PERSON
}

enum InterviewStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  GENERAL
  APPLICATION
  INTERVIEW
  MESSAGE
  SYSTEM
}

enum SecurityEventType {
  SESSION_CREATED
  SESSION_REVOKED
  PASSWORD_CHANGED
  TWO_FACTOR_BOOTSTRAP
}

// ─── User (single auth table for all roles) ──

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String
  role           UserRole  @default(TEACHER)
  phone          String?
  whatsappNumber String?   @map("whatsapp_number")
  whatsappOptin  Boolean   @default(false) @map("whatsapp_optin")
  avatarUrl      String?   @map("avatar_url")
  emailVerified  Boolean   @default(false) @map("email_verified")
  isSuspended    Boolean   @default(false) @map("is_suspended")
  suspendedAt    DateTime? @map("suspended_at") @db.Timestamptz
  suspendedUntil DateTime? @map("suspended_until") @db.Timestamptz
  suspensionReason String? @map("suspension_reason") @db.Text
  suspendedByAdminId String? @map("suspended_by_admin_id") @db.Uuid
  hashedPassword String?   @map("hashed_password") // null for OAuth users
  resetToken     String?   @map("reset_token")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  teacherProfile TeacherProfile?
  schoolProfile  SchoolProfile?
  applications   Application[]
  savedJobs      SavedJob[]
  resumes        Resume[]
  jobPostings    JobPosting[]    // jobs this user posted
  jobAlerts      JobAlert[]
  statusChanges  ApplicationStatusHistory[]
  matchScores    AIMatchScore[]
  conversationsCreated Conversation[] @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[]
  messagesSent Message[]
  notifications Notification[]
  userSessions  UserSession[]
  securityEvents SecurityEvent[]

  @@map("users")
}

// ─── Teacher Profile ─────────────────────────

model TeacherProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  qualification      String?
  experience         String?             // e.g. "3-5 years"
  currentSchool      String?             @map("current_school")
  city               String?
  bio                String?             @db.Text
  subjects           String[]            // array of subjects they teach
  preferredBoards    String[]            @map("preferred_boards") // boards they prefer
  preferredGrades    String[]            @map("preferred_grades") // grade levels they prefer
  expectedSalary     Int?                @map("expected_salary")  // monthly in INR
  availabilityStatus AvailabilityStatus  @default(NOT_LOOKING) @map("availability_status")
  preferredJobTypes  String[]            @default([]) @map("preferred_job_types")
  noticePeriodDays   Int?                @map("notice_period_days")
  tetStatus          String?             @map("tet_status")
  teachingMediums    String[]            @default([]) @map("teaching_mediums")
  demoVideoUrl       String?             @map("demo_video_url")
  lessonPlanUrl      String?             @map("lesson_plan_url")
  pocsoAcknowledged  Boolean             @default(false) @map("pocso_acknowledged")
  referenceCheckDone Boolean             @default(false) @map("reference_check_done")
  codeOfConductSigned Boolean            @default(false) @map("code_of_conduct_signed")
  safetyBadgeGranted Boolean             @default(false) @map("safety_badge_granted")
  verificationStatus TeacherVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationSubmittedAt DateTime?      @map("verification_submitted_at") @db.Timestamptz
  verificationNotes  String?             @map("verification_notes") @db.Text
  verificationTimestamp DateTime?        @map("verification_timestamp") @db.Timestamptz
  verifiedByAdminId  String?             @map("verified_by_admin_id") @db.Uuid
  verificationRejectionReason String?    @map("verification_rejection_reason") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences      Experience[]
  certifications   Certification[]

  @@index([city])
  @@index([subjects])
  @@index([verificationStatus])
  @@map("teacher_profiles")
}

// ─── Experience (work history) ───────────────

model Experience {
  id               String         @id @default(uuid()) @db.Uuid
  teacherProfileId String         @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  schoolName       String         @map("school_name")
  role             String
  startDate        DateTime       @map("start_date") @db.Timestamptz
  endDate          DateTime?      @map("end_date") @db.Timestamptz
  isCurrent        Boolean        @default(false) @map("is_current")
  description      String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([teacherProfileId])
  @@map("experiences")
}

// ─── Certification ───────────────────────────

model Certification {
  id               String         @id @default(uuid()) @db.Uuid
  teacherProfileId String         @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  name             String
  issuedBy         String         @map("issued_by")
  issuedAt         DateTime       @map("issued_at") @db.Timestamptz
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz
  credentialId     String?        @map("credential_id")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([teacherProfileId])
  @@map("certifications")
}

// ─── School Profile ──────────────────────────

model SchoolProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  schoolName String   @map("school_name")
  city       String
  board      Board
  address    String?  @db.Text
  website    String?
  about      String?  @db.Text
  logoUrl    String?  @map("logo_url")
  hasPfEsi   Boolean  @default(false) @map("has_pf_esi")
  paymentTrackRecord String? @map("payment_track_record")
  workingHours String? @map("working_hours")
  udiseCode  String?  @map("udise_code")
  verified   Boolean  @default(false)
  verificationStatus SchoolVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationSubmittedAt DateTime? @map("verification_submitted_at") @db.Timestamptz
  verificationNotes String? @map("verification_notes") @db.Text
  verificationTimestamp DateTime? @map("verification_timestamp") @db.Timestamptz
  verifiedByAdminId String? @map("verified_by_admin_id") @db.Uuid
  verificationRejectionReason String? @map("verification_rejection_reason") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostings JobPosting[]

  @@index([city])
  @@index([board])
  @@index([verified])
  @@index([verificationStatus])
  @@map("school_profiles")
}

// ─── Job Posting ─────────────────────────────

model JobPosting {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  postedBy    String    @map("posted_by") @db.Uuid
  title       String
  subject     String
  board       Board
  gradeLevel  String    @map("grade_level") // e.g. "9-12", "Pre-K", "1-5"
  jobType     JobType   @default(FULL_TIME) @map("job_type")
  experience  String?   // e.g. "3-5 years"
  experienceLevel ExperienceLevel? @map("experience_level")
  salaryMin   Int?      @map("salary_min")  // monthly INR
  salaryMax   Int?      @map("salary_max")
  isUrgent    Boolean   @default(false) @map("is_urgent")
  requiredWithin48h Boolean @default(false) @map("required_within_48h")
  requiresTet Boolean   @default(false) @map("requires_tet")
  applicationDeadline DateTime? @map("application_deadline") @db.Timestamptz
  description String    @db.Text
  status      JobStatus @default(ACTIVE)
  isHidden    Boolean   @default(false) @map("is_hidden")
  moderationNotes String? @map("moderation_notes") @db.Text
  hiddenAt    DateTime? @map("hidden_at") @db.Timestamptz
  hiddenByAdminId String? @map("hidden_by_admin_id") @db.Uuid
  postedAt    DateTime  @default(now()) @map("posted_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  views       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  school       SchoolProfile    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  poster       User             @relation(fields: [postedBy], references: [id])
  requirements JobRequirement[]
  benefits     JobBenefit[]
  screeningQuestions ScreeningQuestion[]
  applications Application[]
  savedBy      SavedJob[]
  matchScores  AIMatchScore[]

  // Indexes for filtering & search
  @@index([status])
  @@index([subject])
  @@index([board])
  @@index([gradeLevel])
  @@index([experienceLevel])
  @@index([salaryMin, salaryMax])
  @@index([applicationDeadline])
  @@index([postedAt(sort: Desc)])
  @@index([schoolId])
  @@index([isHidden])
  @@index([status, postedAt(sort: Desc)]) // composite: active jobs newest first
  @@map("job_postings")
}

// ─── Job Requirements (one per row) ──────────

model JobRequirement {
  id        String @id @default(uuid()) @db.Uuid
  jobId     String @map("job_id") @db.Uuid
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  // Relations
  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_requirements")
}

// ─── Job Benefits (one per row) ──────────────

model JobBenefit {
  id        String @id @default(uuid()) @db.Uuid
  jobId     String @map("job_id") @db.Uuid
  text      String
  sortOrder Int    @default(0) @map("sort_order")

  // Relations
  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_benefits")
}

model ScreeningQuestion {
  id        String  @id @default(uuid()) @db.Uuid
  jobId     String  @map("job_id") @db.Uuid
  question  String  @db.Text
  required  Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  job     JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers ScreeningAnswer[]

  @@index([jobId])
  @@map("screening_questions")
}

// ─── Application ─────────────────────────────

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  applicantId String            @map("applicant_id") @db.Uuid
  coverLetter String?           @map("cover_letter") @db.Text
  resumeId         String?              @map("resume_id") @db.Uuid
  status           ApplicationStatus    @default(PENDING)
  schoolNotes      String?              @map("school_notes") @db.Text // internal notes
  rejectionReason  RejectionReason?     @map("rejection_reason")
  appliedAt        DateTime             @default(now()) @map("applied_at") @db.Timestamptz
  reviewedAt       DateTime?            @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  job            JobPosting              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant      User                    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resume         Resume?                 @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  screeningAnswers ScreeningAnswer[]
  statusHistory  ApplicationStatusHistory[]
  interview      Interview?

  // Prevent duplicate applications
  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
  @@index([appliedAt(sort: Desc)])
  @@map("applications")
}

model ScreeningAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  questionSnapshot String   @map("question_snapshot") @db.Text
  answer           String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    ScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@index([questionId])
  @@map("screening_answers")
}

// ─── Resume (file uploads) ───────────────────

model Resume {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fileUrl       String   @map("file_url")  // Supabase Storage URL
  fileName      String   @map("file_name")
  fileSize      Int      @map("file_size") // bytes
  isGenerated   Boolean  @default(false) @map("is_generated")
  template      String?  // "ats-friendly", "modern", "minimal" for generated resumes
  generatedData Json?    @map("generated_data") // metadata about what was used to generate
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@map("resumes")
}

// ─── Saved Jobs (bookmarks) ──────────────────

model SavedJob {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  jobId   String   @map("job_id") @db.Uuid
  savedAt DateTime @default(now()) @map("saved_at") @db.Timestamptz

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId]) // can't save the same job twice
  @@index([userId])
  @@map("saved_jobs")
}

// ─── Job Alert ───────────────────────────

model JobAlert {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  name           String          // e.g. "Math jobs in Bangalore"
  subject        String?         // filter by subject
  city           String?         // filter by city
  board          Board?          // CBSE, ICSE, etc
  gradeLevel     String?         @map("grade_level") // e.g. "9-12"
  jobType        JobType?        @map("job_type")
  salaryMin      Int?            @map("salary_min")
  salaryMax      Int?            @map("salary_max")
  frequency      AlertFrequency  @default(DAILY_DIGEST)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertHistory   AlertHistory[]

  @@index([userId])
  @@index([isActive])
  @@map("job_alerts")
}

// ─── Alert History ───────────────────────

model AlertHistory {
  id             String          @id @default(uuid()) @db.Uuid
  alertId        String          @map("alert_id") @db.Uuid
  jobIds         String[]        @map("job_ids") @db.Uuid // jobs sent in this digest
  sentAt         DateTime        @default(now()) @map("sent_at") @db.Timestamptz
  openedAt       DateTime?       @map("opened_at")
  clickedAt      DateTime?       @map("clicked_at")

  // Relations
  alert          JobAlert        @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([sentAt(sort: Desc)])
  @@map("alert_history")
}

// ─── Application Status History (audit trail) ─

model ApplicationStatusHistory {
  id              String            @id @default(uuid()) @db.Uuid
  applicationId   String            @map("application_id") @db.Uuid
  fromStatus      ApplicationStatus @map("from_status")
  toStatus        ApplicationStatus @map("to_status")
  changedBy       String            @map("changed_by") @db.Uuid
  changedAt       DateTime          @default(now()) @map("changed_at") @db.Timestamptz
  note            String?           @db.Text
  rejectionReason RejectionReason?  @map("rejection_reason")

  // Relations
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedByUser User        @relation(fields: [changedBy], references: [id])

  @@index([applicationId])
  @@index([changedAt(sort: Desc)])
  @@map("application_status_history")
}

// ─── Interview (Phase 4) ──────────────────────

model Interview {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @unique @map("application_id") @db.Uuid
  scheduledAt   DateTime        @map("scheduled_at") @db.Timestamptz
  durationMins  Int             @default(30) @map("duration_mins")
  type          InterviewType   @default(VIDEO)
  meetingLink   String?         @map("meeting_link")
  location      String?         // for IN_PERSON
  status        InterviewStatus @default(PENDING)
  schoolNotes   String?         @map("school_notes") @db.Text
  teacherNotes  String?         @map("teacher_notes") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@map("interviews")
}

// ─── AI Match Score (Phase 4) ─────────────────

model AIMatchScore {
  id          String   @id @default(uuid()) @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  applicantId String   @map("applicant_id") @db.Uuid
  score       Float    // 0.0 - 1.0
  breakdown   Json     // { subject, location, board, salary, experience } component scores
  explanation String   // "Matches your Math + Science skills in Chennai"
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz

  // Relations
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   User       @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobId, applicantId])
  @@index([jobId, score(sort: Desc)])
  @@map("ai_match_scores")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  createdBy     String   @map("created_by") @db.Uuid
  subject       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz

  creator      User                      @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([createdBy])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
  @@map("messages")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType @default(GENERAL)
  title      String
  body       String           @db.Text
  payload    Json?
  readAt     DateTime?        @map("read_at") @db.Timestamptz
  archivedAt DateTime?        @map("archived_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt, readAt, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("notifications")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionToken String    @unique @map("session_token")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastActiveAt(sort: Desc)])
  @@map("user_sessions")
}

model SecurityEvent {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  eventType   SecurityEventType @map("event_type")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("security_events")
}

model DomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String   @map("event_type")
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  actorId       String?  @map("actor_id")
  payload       Json
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  consumers     DomainEventConsumer[]

  @@index([aggregateType, aggregateId, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("domain_events")
}

model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  scope           String
  actorKey        String   @map("actor_key")
  idempotencyKey  String   @map("idempotency_key")
  requestHash     String   @map("request_hash")
  status          String   @default("PENDING")
  responseStatus  Int?     @map("response_status")
  responseBody    Json?    @map("response_body")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz

  @@unique([scope, actorKey, idempotencyKey])
  @@index([scope, actorKey, createdAt(sort: Desc)])
  @@map("idempotency_keys")
}

model RateLimitEvent {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @map("key")
  action     String
  actorKey   String?  @map("actor_key")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([key, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("rate_limit_events")
}

model DomainEventConsumer {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  consumerName  String   @map("consumer_name")
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  lastError     String?  @map("last_error") @db.Text
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumerName])
  @@index([consumerName, status, createdAt(sort: Asc)])
  @@map("domain_event_consumers")
}

model BackgroundJob {
  id          String   @id @default(uuid()) @db.Uuid
  jobType     String   @map("job_type")
  status      String   @default("PENDING")
  dedupeKey   String?  @unique @map("dedupe_key")
  payload     Json
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  runAt       DateTime @default(now()) @map("run_at") @db.Timestamptz
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz
  lastError   String?  @map("last_error") @db.Text
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([jobType, status, runAt(sort: Asc)])
  @@map("background_jobs")
}

