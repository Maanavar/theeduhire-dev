# Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# App URLs
# Use a public https URL in production.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="EduHire <noreply@theeduhire.in>"
ADMIN_EMAIL="admin@theeduhire.in"

# Supabase (file storage)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Optional integrations
MSG91_AUTH_KEY="your-auth-key"
MSG91_SENDER_ID="EDUHRE"
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your-secret"
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Operational secrets
CRON_SECRET="replace-with-a-long-random-secret"
# DANGER: never run destructive scripts against production data.
# Required only for destructive local/demo reset and reseed scripts.
DATABASE_SAFETY_LABEL="local"
CONFIRM_DESTRUCTIVE_DB_SCRIPT="I_UNDERSTAND_THIS_DESTROYS_DATA"
ALLOW_SMOKE_DATA_SCRIPT="I_UNDERSTAND_THIS_WRITES_TEST_DATA"
SEED_DEFAULT_PASSWORD="replace-with-a-strong-local-demo-password"
RESET_PASSWORD="replace-with-a-strong-local-reset-password"

# Feature flags (0/1 or false/true)
NEXT_PUBLIC_FF_PIPELINE_BOARD="0"
NEXT_PUBLIC_FF_MESSAGING="0"
NEXT_PUBLIC_FF_NOTIFICATIONS_CENTER="0"
NEXT_PUBLIC_FF_SETTINGS_SECURITY="0"
NEXT_PUBLIC_FF_SCHOOL_LIVE_UPDATES="1"

# Staged rollout order (recommended):
# PIPELINE -> MESSAGING -> NOTIFICATIONS -> SETTINGS_SECURITY
